{
  "manifest_version": 3,
  "name": "YouTube Music Remover",
  "version": "0.2.0",
  "description": "Removes background music from YouTube videos and Shorts while you watch, using a local server.",
  "permissions": ["storage", "scripting", "unlimitedStorage"],
  "host_permissions": [
    "http://127.0.0.1/*", "http://localhost/*",
    "https://www.youtube.com/*", "https://m.youtube.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Music Remover" }
}
